# Bu dosyayı ".env" adıyla kopyala ve sadece kullandığın servislerin anahtarlarını doldur.
# .env dosyası GitHub'a GÖNDERİLMEZ (.gitignore içinde).

# Görseller için (images.default_engine: gemini ya da shot bazında engine: gemini)
GEMINI_API_KEY=

# Ücretli seslendirme için (tts.provider: elevenlabs)
ELEVENLABS_API_KEY=

# Otomatik storyboard planlama için (planner.provider: anthropic)
ANTHROPIC_API_KEY=

# Fikir havuzu talep/rekabet sinyalleri için (YouTube Data API v3, ücretsiz günlük kota)
YOUTUBE_API_KEY=
